<Window x:Class="AutoBossManager.Views.BotProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bot Profile"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E24"
        WindowStyle="ToolWindow">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A0AEC0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F4E"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="THÔNG TIN ACCOUNT" FontSize="13" FontWeight="Bold" Foreground="#3B82F6" Margin="0,0,0,6"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="Account name *:" Grid.Row="0" Grid.Column="0"/>
            <TextBox x:Name="TxtAccountName" Grid.Row="0" Grid.Column="1"/>

            <TextBlock Text="Username:" Grid.Row="1" Grid.Column="0"/>
            <TextBox x:Name="TxtUsername" Grid.Row="1" Grid.Column="1"/>

            <TextBlock Text="Password:" Grid.Row="2" Grid.Column="0"/>
            <PasswordBox x:Name="PwbPassword" Background="#2A2A35" Foreground="White"
                         BorderBrush="#3F3F4E" Padding="6,4" Margin="0,2" Grid.Row="2" Grid.Column="1"/>

            <TextBlock Text="Game exe path *:" Grid.Row="3" Grid.Column="0"/>
            <DockPanel Grid.Row="3" Grid.Column="1">
                <Button x:Name="BtnBrowse" Content="..." Width="34" DockPanel.Dock="Right" Click="BtnBrowse_Click" Margin="4,2,0,2"/>
                <TextBox x:Name="TxtGameExe"/>
            </DockPanel>

            <TextBlock Text="Home map:" Grid.Row="4" Grid.Column="0"/>
            <TextBox x:Name="TxtHomeMap" Grid.Row="4" Grid.Column="1"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
            <TextBlock Text="CẤU HÌNH BOSS" FontSize="13" FontWeight="Bold" Foreground="#10B981"/>
            <TextBlock Text="  Strategy preset:" FontSize="11" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <ComboBox x:Name="CmbPreset" Width="140" Background="#2A2A35" Foreground="White"
                      SelectionChanged="CmbPreset_SelectionChanged">
                <ComboBoxItem Content="(mặc định Balanced)" IsSelected="True"/>
                <ComboBoxItem Content="Aggressive"/>
                <ComboBoxItem Content="Balanced"/>
                <ComboBoxItem Content="Safe"/>
            </ComboBox>
        </StackPanel>
        <TextBlock Text="Boss targets (mỗi dòng 1 tên):" FontSize="11"/>
        <TextBox x:Name="TxtBossNames" Height="52" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"/>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Max zone attempts:" FontSize="11"/>
                <TextBox x:Name="TxtMaxZoneAttempts"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Attack range:" FontSize="11"/>
                <TextBox x:Name="TxtAttackRange"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Text="Combat timeout (s):" FontSize="11"/>
                <TextBox x:Name="TxtCombatTimeout"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Retreat HP %:" FontSize="11"/>
                <TextBox x:Name="TxtRetreatHp"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Loot radius:" FontSize="11"/>
                <TextBox x:Name="TxtLootRadius"/>
            </StackPanel>
        </Grid>

        <CheckBox x:Name="ChkLaunchNow" Content="🚀 Launch game ngay sau khi lưu"
                  Foreground="#A0AEC0" Margin="0,12,0,0"/>

        <TextBlock x:Name="TxtError" Foreground="#EF4444" FontWeight="Bold" Margin="0,8,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="💾 Lưu" Background="#10B981" Foreground="White" BorderThickness="0" Click="BtnSave_Click"/>
            <Button Content="✖ Hủy" Background="#4A5568" Foreground="White" BorderThickness="0" Click="BtnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
