<Window x:Class="AutoBossManager.Views.BotConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bot Config - Push xuống bot"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E24"
        WindowStyle="ToolWindow">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A0AEC0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F4E"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock x:Name="TxtHeader" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,10"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                <TextBlock Text="Max zone attempts:" FontSize="11"/>
                <TextBox x:Name="TxtMaxZoneAttempts"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,6">
                <TextBlock Text="Attack range:" FontSize="11"/>
                <TextBox x:Name="TxtAttackRange"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Text="Combat timeout (s):" FontSize="11"/>
                <TextBox x:Name="TxtCombatTimeout"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Retreat HP %:" FontSize="11"/>
                <TextBox x:Name="TxtRetreatHp"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Loot radius:" FontSize="11"/>
                <TextBox x:Name="TxtLootRadius"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Boss targets (mỗi dòng 1 tên - gửi key 'bossNames'):" FontSize="11" Margin="0,10,0,2"/>
        <TextBox x:Name="TxtBossNames" Height="64" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"/>

        <TextBlock Text="Skill triggers (mỗi dòng: hpCảnhBáo,keyPhím,sốLầnVí dụ: 500000,1,2):" FontSize="11" Margin="0,10,0,2"/>
        <TextBox x:Name="TxtSkillTriggers" Height="64" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"/>

        <CheckBox x:Name="ChkAutoZone" Content="Tự động chuyển khu khi quét hết" Foreground="#A0AEC0" Margin="0,10,0,0"/>

        <TextBlock x:Name="TxtError" Foreground="#EF4444" FontWeight="Bold" Margin="0,8,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="📤 Lưu + Push" Background="#3B82F6" Foreground="White" BorderThickness="0"
                    Padding="14,6" MinWidth="110" Click="BtnPush_Click"/>
            <Button Content="✖ Hủy" Background="#4A5568" Foreground="White" BorderThickness="0"
                    Padding="14,6" MinWidth="90" Click="BtnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
