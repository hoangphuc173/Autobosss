<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <!-- Managed dep cua Il2CppInterop -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plugin + Shared (transitively pulls AutoBossShared) -->
    <ProjectReference Include="..\..\src\AutoBossGrabber\AutoBossGrabber.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Managed refs de JIT resolve kieu Plugin (BasePlugin) trong test.
         Khong can Unity interop DLL vi data model da thuan .NET (MapPoint). -->
    <Reference Include="BepInEx.Core">
      <HintPath>..\..\libs\BepInExCore\BepInEx.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>..\..\libs\BepInExCore\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>..\..\libs\BepInExCore\Il2CppInterop.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>..\..\libs\BepInExCore\Il2CppInterop.Runtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
